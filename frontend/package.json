{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "npm run typecheck:app && npm run typecheck:cypress",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:cypress": "tsc -p cypress/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest",
    "test:unit": "vitest run src/**/*.service.spec.ts src/**/*.interceptor.spec.ts",
    "test:integration": "vitest run src/**/*.page.spec.ts",
    "test:component": "vitest run src/**/*.component.spec.ts",
    "test:unit:watch": "vitest",
    "test:e2e": "cypress run --e2e",
    "test:e2e:watch": "cypress open --e2e",
    "test:e2e:feature": "cypress run --e2e --spec 'cypress/e2e/features/**/*.feature'",
    "test:all": "npm run test:unit && npm run test:component && npm run test:integration && npm run test:e2e"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": true,
    "arrowParens": "always",
    "tabWidth": 2,
    "useTabs": false,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.4",
    "@angular-devkit/core": "^21.1.4",
    "@angular-eslint/eslint-plugin": "^20.2.0",
    "@angular-eslint/eslint-plugin-template": "^20.2.0",
    "@angular-eslint/template-parser": "^20.2.0",
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.1.5",
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@cypress/angular": "^4.1.0",
    "@cypress/webpack-dev-server": "^5.6.0",
    "@cypress/webpack-preprocessor": "^7.0.2",
    "@eslint/js": "^9.21.0",
    "@percy/cypress": "^3.1.7",
    "cypress": "^15.10.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^4.0.7",
    "zone.js": "^0.16.1"
  }
}
