{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:component": "cypress run --component",
    "test:component:watch": "cypress open --component",
    "test:e2e": "cypress run --e2e",
    "test:e2e:watch": "cypress open --e2e",
    "test:e2e:feature": "cypress run --e2e --spec 'cypress/e2e/features/**/*.feature'",
    "test:all": "npm run test:unit && npm run test:component && npm run test:e2e"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.0",
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@cypress/webpack-dev-server": "^5.6.0",
    "@cypress/webpack-preprocessor": "^7.0.2",
    "@percy/cypress": "^3.1.7",
    "cypress": "^15.10.0",
    "typescript": "~5.9.2"
  }
}
